      "input_utf8": "abc<tool_call>f<arg_key>a</arg_key><arg_value>1</arg_value></tool_call>",
      "tool_call_parser": "glm47@1",
      "finish_reason": "FINISH_REASON_V1_EOS_TOKEN",
      "expected": {
        "reasoning_content": "abc<tool_call>f<arg_key>a</arg_key><arg_value>1</arg_value></tool_call>",
        "content": "",
        "tool_calls": []
      }
    },
    {
      "name": "reasoning_then_unclosed_call_no_recovery_eos",
      "input_utf8": "abc</think><tool_call>f<arg_key>a</arg_key><arg_value>1</arg_value>",
      "tool_call_parser": "glm47@1",
      "finish_reason": "FINISH_REASON_V1_EOS_TOKEN",
      "expected": {
        "reasoning_content": "abc",
        "content": "<tool_call>f<arg_key>a</arg_key><arg_value>1</arg_value>",
        "tool_calls": []
      }
    },
    {
      "name": "stream_split_inside_markers",
      "input_utf8": "<think>abc</think>ok",
      "tool_call_parser": null,
