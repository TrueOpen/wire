  "notes": [
    "list_hash = sha256('TRUEOPEN_ANCHOR_KV_LIST_V1' || chain_id || task_id || u64_be(rows) || list), list = rows entries of 32 bytes.",
    "position_beacon = sha256('TRUEOPEN_ANCHOR_POSITION_BEACON_V1' || chain_id || task_id || u64_be(first_height) || u32_be(m) || beacon(first_height) || ... || beacon(first_height + m - 1)).",
    "position draw: for i = 0, 1, ... (at most 64 draws) p = u64_be(sha256('TRUEOPEN_ANCHOR_SAMPLE_V1' || chain_id || task_id || sample_beacon || list_hash || position_beacon || u32_be(i))[0:8]) mod rows; duplicates are skipped; the result is sorted ascending.",
    "chain_id is its UTF-8 bytes without a length prefix; every other input has a fixed length.",
    "The list entries of these vectors are arbitrary 32-byte strings: the vectors pin the hashing only."
  ],
